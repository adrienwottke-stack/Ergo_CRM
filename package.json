{
  "name": "ergo-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "build:check": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./scripts/alias-hook.mjs --test scripts/arbeitslagen.test.mjs scripts/vereinbarungen-test.mjs scripts/vereinbarungen-service-test.mjs scripts/team-auswertung-probe.mjs scripts/team-auswertung-db.test.mjs scripts/contact-result-review.test.mjs lib/ziele-modell.test.mjs lib/ziele-service.test.mjs scripts/einheiten-meldungen.test.mjs scripts/cron-meldungen.test.mjs scripts/fuehrung-scope-db.test.mjs scripts/start-state.test.mjs scripts/start-service.test.mjs scripts/storno-tutorial.test.mjs lib/rueckweg.test.mjs",
    "test:browser": "node --import ./scripts/alias-hook.mjs scripts/arbeitslagen-browser.mjs",
    "test:suche": "node --import ./scripts/alias-hook.mjs --test scripts/suche.test.mjs scripts/suche-db.test.mjs",
    "test:suche:browser": "node --import ./scripts/alias-hook.mjs scripts/suche-browser.mjs",
    "test:start": "node --import ./scripts/alias-hook.mjs --test scripts/start-state.test.mjs scripts/start-service.test.mjs scripts/storno-tutorial.test.mjs",
    "test:start:browser": "node --import ./scripts/alias-hook.mjs scripts/start-browser.test.mjs",
    "build:start:check": "node --import ./scripts/alias-hook.mjs scripts/start-build-check.mjs",
    "test:redesign:browser": "node --import ./scripts/alias-hook.mjs scripts/redesign-browser.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "next": "15.5.23",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
