generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactStatus {
  NEW
  CONTACTED
  APPOINTMENT
  CLOSED
  REJECTED
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
}

model Contact {
  id         String        @id @default(cuid())
  name       String
  phone      String?
  email      String?
  source     String?
  status     ContactStatus @default(NEW)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  activities Activity[]
}

model Activity {
  id        String       @id @default(cuid())
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      ActivityType
  text      String
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@index([contactId])
}

// --- Team-Wettbewerb: taegliche Aktivitaets-Zaehler, getrennt vom privaten Kontakt-CRM ---

enum QuotaType {
  CALL
  NUMBERS_PULLED
  APPOINTMENT_SET
}

model Person {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  dailyLogs DailyLog[]
}

model DailyLog {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      QuotaType
  count     Int
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([personId, date])
}
