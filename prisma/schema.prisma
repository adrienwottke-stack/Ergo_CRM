generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactStatus {
  NEW
  CONTACTED
  APPOINTMENT
  CLOSED
  REJECTED
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
}

enum UserRole {
  ADMIN
  MEMBER
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  source       String?
  status       ContactStatus @default(NEW)
  note         String?
  nextFollowUp DateTime?
  appointmentLoggedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String?
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([ownerId, updatedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordSalt String
  passwordHash String
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  contacts     Contact[]
  person       Person?
}

model Activity {
  id        String       @id @default(cuid())
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      ActivityType
  text      String
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  quotaLog  DailyLog?

  @@index([contactId])
}

// --- Team-Wettbewerb: taegliche Aktivitaets-Zaehler, getrennt vom privaten Kontakt-CRM ---

enum QuotaType {
  CALL
  NUMBERS_PULLED
  APPOINTMENT_SET
}

model Person {
  id        String     @id @default(cuid())
  name      String     @unique
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  dailyLogs DailyLog[]
}

model DailyLog {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  activityId String?  @unique
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  type      QuotaType
  count     Int
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([personId, date])
}
