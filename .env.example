# Supabase Postgres – Transaction Pooler (Port 6543), wird von der App genutzt
DATABASE_URL="postgresql://postgres.<project-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres – Session Pooler / direkte Verbindung (Port 5432), nur für Migrationen
DIRECT_URL="postgresql://postgres.<project-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Passwort für den Login der App
APP_PASSWORD="bitte-aendern"
