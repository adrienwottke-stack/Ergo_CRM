# Supabase Postgres – Transaction Pooler (Port 6543), wird von der App genutzt
DATABASE_URL="postgresql://postgres.<project-ref>:<passwort>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres – Session Pooler (Port 5432), nur für Prisma-Migrationen.
# Muss auch in Vercel gesetzt sein: der Build startet mit "prisma migrate deploy".
DIRECT_URL="postgresql://postgres.<project-ref>:<passwort>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Nur für die einmalige Anlage des ersten Admin-Kontos. Danach meldet sich der
# Admin mit seiner E-Mail-Adresse und diesem Passwort an.
APP_PASSWORD="bitte-aendern"

# Zufälliges, langes Geheimnis zum Signieren persönlicher Sitzungen.
# In Produktion unbedingt setzen; mindestens 32 zufällige Zeichen verwenden.
SESSION_SECRET="bitte-langes-zufaelliges-geheimnis-setzen"

# Web-Push (Meldungen). Schlüsselpaar erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Ohne diese Werte läuft die App vollständig – nur ohne Meldungen.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@example.com"

# Schützt /api/cron/meldungen. In Vercel setzen; der Cron-Lauf steht in vercel.json.
CRON_SECRET=""
